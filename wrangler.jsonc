// Lets Cloudflare deploy the battle server straight from the repository root (for example
// Workers Builds without a root directory set). Same settings as
// backend/cloudflare/wrangler.jsonc; a test checks that the two stay in sync.
{
  "$schema": "backend/cloudflare/node_modules/wrangler/config-schema.json",
  "name": "game-suite",
  "main": "backend/cloudflare/src/index.js",
  "compatibility_date": "2025-09-01",
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "DIRECTORY", "class_name": "Directory" }
    ]
  },
  // SQLite-backed Durable Objects are available on the free plan.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["Directory"] }
  ],
  // Keep variables added in the dashboard (even as Text) when deploying from GitHub.
  "keep_vars": true,
  "observability": { "enabled": true }
}
